<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Millington Dock Staging</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#0f1115; --panel:#171a21; --panel-alt:#1e222b; --panel-hi:#252a35;
  --border:#2c323e; --border-soft:#232833;
  --text:#e8eaef; --muted:#8d95a5; --faint:#5f6676;
  --amber:#f2a93b; --red:#ef5b5b; --red-bg:rgba(239,91,91,.14);
  --gridded:#5cb8e8; --staged:#f4a77a; --complete:#71d38e;
  --gridded-bg:rgba(92,184,232,.12); --staged-bg:rgba(244,167,122,.12); --complete-bg:rgba(113,211,142,.10);
  --disp:'Oswald',sans-serif; --sans:'IBM Plex Sans',system-ui,sans-serif; --mono:'IBM Plex Mono',monospace;
}
*{box-sizing:border-box;}
html,body{margin:0;background:var(--bg);color:var(--text);font-family:var(--sans);font-size:14px;}
button,input,select,textarea{font-family:inherit;font-size:inherit;color:inherit;}
a{color:var(--gridded);}

/* ---------- top bar ---------- */
.topbar{position:sticky;top:0;z-index:50;display:flex;align-items:center;gap:14px;padding:10px 20px;
  background:rgba(15,17,21,.94);backdrop-filter:blur(6px);border-bottom:1px solid var(--border);}
.brand{display:flex;align-items:center;gap:11px;min-width:0;}
.logo-badge{width:34px;height:34px;border-radius:8px;background:var(--amber);color:#1a1205;display:flex;align-items:center;justify-content:center;
  font-family:var(--disp);font-weight:700;font-size:16px;letter-spacing:.5px;flex:none;}
.brand h1{margin:0;font-family:var(--disp);font-size:18px;letter-spacing:1.2px;text-transform:uppercase;font-weight:600;line-height:1.1;}
.ceva-logo{background:#fff;border-radius:8px;height:34px;padding:4px 9px;display:flex;align-items:center;flex:none;}
.ceva-logo img{height:100%;width:auto;display:block;}
.clock{font-family:var(--mono);font-size:13px;color:var(--muted);margin-left:6px;white-space:nowrap;}
.spacer{flex:1;}
.pill{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--border);border-radius:999px;padding:4px 10px;font-size:11.5px;
  color:var(--muted);white-space:nowrap;background:var(--panel);}
.pill .dot{width:7px;height:7px;border-radius:50%;background:var(--faint);}
.pill.ok .dot{background:var(--complete);} .pill.warn{color:var(--amber);border-color:rgba(242,169,59,.4);} .pill.warn .dot{background:var(--amber);}
.pill.bad{color:var(--red);border-color:rgba(239,91,91,.4);} .pill.bad .dot{background:var(--red);}
.btn{background:var(--panel-alt);border:1px solid var(--border);border-radius:7px;padding:7px 13px;cursor:pointer;font-weight:600;font-size:13px;
  display:inline-flex;align-items:center;gap:6px;white-space:nowrap;transition:all .12s ease;}
.btn:hover{border-color:var(--amber);color:var(--amber);}
.btn.primary{background:var(--amber);border-color:var(--amber);color:#1a1205;}
.btn.primary:hover{filter:brightness(1.08);color:#1a1205;}
.btn.danger{color:var(--red);border-color:rgba(239,91,91,.35);background:transparent;}
.btn.danger:hover{background:var(--red-bg);}
.btn.ghost{background:transparent;}
.btn.icon{width:34px;height:34px;padding:0;justify-content:center;font-size:15px;}
.btn:disabled{opacity:.45;cursor:not-allowed;}

/* ---------- banner ---------- */
.banner{margin:12px 20px 0;padding:10px 14px;border-radius:8px;font-size:13px;display:none;align-items:center;gap:10px;}
.banner.show{display:flex;}
.banner.warn{background:rgba(242,169,59,.1);border:1px solid rgba(242,169,59,.35);color:#f6c983;}
.banner.bad{background:var(--red-bg);border:1px solid rgba(239,91,91,.35);color:#f59a9a;}

/* ---------- stats ---------- */
.stats{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:10px;padding:14px 20px 0;}
.stat{background:var(--panel);border:1px solid var(--border);border-radius:10px;padding:10px 14px;cursor:pointer;text-align:left;position:relative;overflow:hidden;}
.stat::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c,var(--faint));}
.stat:hover{border-color:var(--c,var(--amber));}
.stat.on{border-color:var(--c,var(--amber));background:var(--panel-alt);}
.stat .lbl{font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);font-weight:600;}
.stat .num{font-family:var(--disp);font-size:28px;font-weight:600;line-height:1.15;color:var(--c,var(--text));}
.stat .sub{font-size:11px;color:var(--faint);}

/* ---------- toolbar ---------- */
.toolbar{display:flex;flex-wrap:wrap;align-items:center;gap:10px;padding:12px 20px;}
.search{flex:1 1 240px;max-width:360px;position:relative;}
.search input{width:100%;background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:8px 10px 8px 32px;}
.search input:focus{outline:none;border-color:var(--amber);}
.search span{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--faint);font-size:14px;}
.seg{display:inline-flex;background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:2px;}
.seg button{background:transparent;border:none;border-radius:5px;padding:6px 11px;cursor:pointer;font-size:12.5px;font-weight:600;color:var(--muted);}
.seg button.on{background:var(--panel-hi);color:var(--text);}
.chips{display:flex;flex-wrap:wrap;gap:6px;}
.chip{background:transparent;border:1px solid var(--border);border-radius:999px;padding:5px 11px;font-size:12px;font-weight:600;cursor:pointer;color:var(--muted);}
.chip.on{border-color:var(--amber);color:var(--amber);background:rgba(242,169,59,.08);}
select.sel{background:var(--panel);border:1px solid var(--border);border-radius:7px;padding:7px 9px;}

/* ---------- board ---------- */
.board{padding:0 20px 40px;}
.lanes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;align-items:start;}
.lane{background:var(--panel);border:1px solid var(--border);border-radius:12px;min-height:120px;}
.lane-head{display:flex;align-items:center;gap:9px;padding:11px 14px;border-bottom:1px solid var(--border-soft);}
.lane-head .sw{width:11px;height:11px;border-radius:3px;background:var(--c);}
.lane-head h2{margin:0;font-family:var(--disp);font-size:14px;letter-spacing:1.4px;text-transform:uppercase;font-weight:600;}
.lane-head .count{margin-left:auto;font-family:var(--mono);font-size:12px;color:var(--muted);background:var(--panel-alt);border-radius:999px;padding:2px 9px;}
.lane-body{padding:12px;display:flex;flex-direction:column;gap:12px;}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(270px,1fr));gap:12px;}
.empty{color:var(--faint);font-size:12.5px;text-align:center;padding:22px 8px;}

.tile{border-radius:12px;overflow:hidden;cursor:pointer;border:1px solid var(--c);background:var(--cbg);transition:transform .1s ease, box-shadow .1s ease;}
.tile:hover{transform:translateY(-1px);box-shadow:0 8px 22px rgba(0,0,0,.35);}
.tile.s-Gridded{--c:var(--gridded);--cbg:var(--gridded-bg);}
.tile.s-Staged{--c:var(--staged);--cbg:var(--staged-bg);}
.tile.s-Complete{--c:var(--complete);--cbg:var(--complete-bg);}
.tile.late{box-shadow:0 0 0 2px var(--red);}
.tile.pending{opacity:.8;}
.t-head{background:var(--c);color:#10141a;padding:9px 12px;display:flex;align-items:center;gap:8px;}
.t-po{font-family:var(--disp);font-size:20px;font-weight:700;letter-spacing:.4px;line-height:1.1;word-break:break-all;}
.t-status{margin-left:auto;font-size:10.5px;font-weight:700;letter-spacing:1px;text-transform:uppercase;background:rgba(16,20,26,.16);border-radius:999px;padding:3px 8px;white-space:nowrap;}
.t-body{padding:10px 12px 11px;display:flex;flex-direction:column;gap:6px;}
.t-sub{font-size:12px;color:var(--muted);}
.t-sub b{color:var(--text);font-weight:600;}
.t-row{display:flex;gap:8px;align-items:baseline;font-size:13px;}
.t-row .k{color:var(--faint);font-size:10.5px;letter-spacing:1px;text-transform:uppercase;font-weight:600;width:58px;flex:none;}
.t-row .v{min-width:0;overflow-wrap:anywhere;}
.t-loc{display:flex;align-items:center;gap:8px;margin-top:2px;padding:7px 10px;border-radius:8px;background:rgba(0,0,0,.22);}
.t-loc .k{font-size:10.5px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);font-weight:600;}
.t-loc .v{font-family:var(--disp);font-size:17px;font-weight:600;color:var(--c);}
.t-loc .v.none{color:var(--faint);font-family:var(--sans);font-size:12.5px;font-weight:500;}
.flags{display:flex;flex-wrap:wrap;gap:5px;}
.flag{font-size:10.5px;font-weight:700;letter-spacing:.6px;text-transform:uppercase;border-radius:5px;padding:3px 7px;}
.flag.late{background:var(--red);color:#fff;}
.flag.soon{background:rgba(242,169,59,.18);color:var(--amber);}
.flag.eta{background:rgba(239,91,91,.14);color:#f59a9a;}
.flag.truck{background:rgba(255,255,255,.07);color:var(--muted);}
.flag.unsent{background:rgba(242,169,59,.18);color:var(--amber);}
.t-actions{display:flex;gap:8px;padding:0 12px 11px;}
.t-actions .btn{flex:1;justify-content:center;padding:6px 10px;font-size:12.5px;}
.t-actions .btn.adv{border-color:var(--next);color:var(--next);background:transparent;}
.t-actions .btn.adv:hover{background:rgba(255,255,255,.05);}

/* ---------- modal ---------- */
.overlay{position:fixed;inset:0;background:rgba(6,7,10,.62);z-index:200;display:none;align-items:flex-start;justify-content:center;padding:40px 16px;overflow-y:auto;}
.overlay.show{display:flex;}
.modal{background:var(--panel);border:1px solid var(--border);border-radius:12px;width:100%;max-width:680px;box-shadow:0 20px 50px rgba(0,0,0,.55);}
.modal.sm{max-width:420px;}
.m-head{display:flex;align-items:center;gap:10px;padding:14px 18px;border-bottom:1px solid var(--border-soft);}
.m-head h3{margin:0;font-family:var(--disp);font-size:16px;letter-spacing:1.2px;text-transform:uppercase;font-weight:600;}
.m-head .x{margin-left:auto;}
.m-body{padding:16px 18px;}
.m-foot{display:flex;flex-wrap:wrap;gap:8px;padding:12px 18px;border-top:1px solid var(--border-soft);}
.form{display:grid;grid-template-columns:1fr 1fr;gap:12px 14px;}
.form .full{grid-column:1/-1;}
.f label{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--muted);font-weight:600;margin-bottom:5px;}
.f label .req{color:var(--amber);}
.f input,.f select,.f textarea{width:100%;background:var(--bg);border:1px solid var(--border);border-radius:7px;padding:8px 10px;}
.f input:focus,.f select:focus,.f textarea:focus{outline:none;border-color:var(--amber);}
.f textarea{min-height:64px;resize:vertical;}
.f .hint{font-size:11px;color:var(--faint);margin-top:4px;}
.status-pick{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;}
.status-pick button{border:1px solid var(--border);background:var(--bg);border-radius:8px;padding:9px;cursor:pointer;font-weight:700;font-size:13px;color:var(--muted);}
.status-pick button[data-s="Gridded"].on{background:var(--gridded);border-color:var(--gridded);color:#10141a;}
.status-pick button[data-s="Staged"].on{background:var(--staged);border-color:var(--staged);color:#10141a;}
.status-pick button[data-s="Complete"].on{background:var(--complete);border-color:var(--complete);color:#10141a;}
.err{color:#f59a9a;font-size:12.5px;margin-top:10px;min-height:1em;}
.hist{margin-top:16px;border-top:1px solid var(--border-soft);padding-top:12px;}
.hist h4{margin:0 0 8px;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;color:var(--muted);}
.hist ul{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:6px;max-height:180px;overflow-y:auto;}
.hist li{font-size:12px;color:var(--muted);}
.hist li b{color:var(--text);font-weight:600;}
.meta{font-size:11.5px;color:var(--faint);margin-top:12px;}
.tabs{display:flex;gap:4px;border-bottom:1px solid var(--border-soft);margin:-4px 0 14px;}
.tabs button{background:transparent;border:none;border-bottom:2px solid transparent;padding:8px 12px;cursor:pointer;font-weight:600;color:var(--muted);font-size:13px;}
.tabs button.on{color:var(--amber);border-bottom-color:var(--amber);}
.checks{display:flex;flex-wrap:wrap;gap:12px;}
.checks label{display:flex;align-items:center;gap:6px;font-size:13px;text-transform:none;letter-spacing:0;color:var(--text);font-weight:500;}

/* ---------- toast ---------- */
.toasts{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);z-index:300;display:flex;flex-direction:column;gap:8px;align-items:center;}
.toast{background:var(--panel-hi);border:1px solid var(--border);border-radius:9px;padding:10px 14px;font-size:13px;display:flex;align-items:center;gap:12px;
  box-shadow:0 10px 30px rgba(0,0,0,.45);max-width:90vw;}
.toast.bad{border-color:rgba(239,91,91,.5);}
.toast button{background:transparent;border:none;color:var(--amber);font-weight:700;cursor:pointer;}

/* ---------- TV mode ---------- */
body.tv .hide-tv{display:none !important;}
body.tv{font-size:15px;}
body.tv .t-po{font-size:24px;}
body.tv .t-loc .v{font-size:21px;}
body.tv .grid{grid-template-columns:repeat(auto-fill,minmax(300px,1fr));}
.show-tv{display:none !important;}
body.tv .show-tv{display:inline-flex !important;}

@media (max-width:1000px){
  .lanes{grid-template-columns:1fr;}
  .stats{grid-template-columns:repeat(3,minmax(0,1fr));}
  .clock{display:none;}
}
@media (max-width:640px){
  .topbar{flex-wrap:wrap;padding:10px 16px;}
  .brand h1{font-size:15px;}
  .ceva-logo{height:30px;padding:3px 7px;}
  .stats{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px 16px 0;}
  .toolbar,.board{padding-left:16px;padding-right:16px;}
  .form{grid-template-columns:1fr;}
}
</style>
</head>
<body>

<header class="topbar">
  <div class="brand">
    <div class="ceva-logo"><img src="data:image/png;base64," alt="CEVA Logistics"></div>
    <h1>Millington Dock Staging</h1>
  </div>
  <div class="clock" id="clock"></div>
  <div class="spacer"></div>
  <span class="pill" id="syncPill" title="Connection to Google Sheets"><span class="dot"></span><span id="syncText">Connecting…</span></span>
  <button class="btn primary hide-tv" id="addBtn">＋ Add Order</button>
  <button class="btn hide-tv" id="exportBtn">⇩ Export</button>
  <button class="btn icon hide-tv" id="refreshBtn" title="Refresh now">⟳</button>
  <button class="btn icon hide-tv" id="tvBtn" title="TV mode (full screen, view only)">⛶</button>
  <button class="btn show-tv" id="tvExitBtn">Exit TV mode</button>
  <button class="btn icon hide-tv" id="settingsBtn" title="Settings">⚙</button>
</header>

<div class="banner warn" id="queueBanner"></div>

<section class="stats" id="stats"></section>

<section class="toolbar hide-tv">
  <div class="search"><span>⌕</span><input id="search" type="search" placeholder="Search PO, order #, customer, carrier, door…" autocomplete="off"></div>
  <div class="seg" id="scopeSeg">
    <button data-v="active" class="on" title="Everything open, plus anything completed or picking up today">Active</button>
    <button data-v="today">Today</button>
    <button data-v="tomorrow">Tomorrow</button>
    <button data-v="week">Next 7 days</button>
    <button data-v="all" title="Last 14 days and everything upcoming">All</button>
  </div>
  <div class="chips" id="clientChips"></div>
  <div class="spacer"></div>
  <div class="seg" id="viewSeg">
    <button data-v="lanes" class="on">Lanes</button>
    <button data-v="grid">Grid</button>
  </div>
</section>

<main class="board" id="board"></main>

<div class="overlay" id="overlay"><div class="modal" id="modal"></div></div>
<div class="toasts" id="toasts"></div>

<script>
(function(){
"use strict";

/* ============================== CONFIG ============================== */
// Web App URL from the "Dock Staging Data" sheet's Apps Script deployment.
var DEFAULT_URL = 'https://script.google.com/macros/s/AKfycbw8L9uc3jFPRLWJmg5Lg983c19CFbpdDM5CFbDWIyBi6UOvrI4csJliZ31AC1wXVbZZ/exec';
var APP_VERSION = '1.1.0';
var STATUSES = ['Gridded','Staged','Complete'];
var HISTORY_DAYS = 14;          // completed orders older than this aren't loaded onto the board
var DUE_SOON_MIN = 120;         // "Due soon" flag window
var LS = { url:'ds_url', cache:'ds_cache_v1', queue:'ds_queue_v1', prefs:'ds_prefs_v1' };

/* ============================== STORAGE ============================== */
function lsGet(k, fb){ try{ var v = localStorage.getItem(k); return v == null ? fb : JSON.parse(v); }catch(e){ return fb; } }
function lsSet(k, v){ try{ localStorage.setItem(k, JSON.stringify(v)); }catch(e){} }
function lsDel(k){ try{ localStorage.removeItem(k); }catch(e){} }

var prefs = Object.assign({ view:'lanes', scope:'active', client:'All', lastClient:'', refreshSec:30 }, lsGet(LS.prefs, {}));
function savePrefs(){ lsSet(LS.prefs, prefs); }

var cache = lsGet(LS.cache, null) || {};
var state = {
  orders: cache.orders || [],
  config: Object.assign({ siteName:'B1 Dock', doors:[], clients:[], carriers:[], customers:[], lateGraceMin:15 }, cache.config || {}),
  queue: lsGet(LS.queue, []),
  lastSync: cache.lastSync || null,
  online: null,
  syncing: false,
  q: '',
  quick: null
};

// Earlier builds may have saved the retired URL on this PC; drop it so the built-in one is used.
(function(){ var saved = lsGet(LS.url, ''); if(saved && saved.indexOf('AKfycbxcPXbdgZiXnrqWQr3V2xrg55dQytOc6MzQwnYpFdFW3MNBc') !== -1) lsDel(LS.url); })();
function apiUrl(){ return (lsGet(LS.url, '') || DEFAULT_URL || '').trim(); }

/* ============================== HELPERS ============================== */
function $(id){ return document.getElementById(id); }
function esc(s){ return String(s == null ? '' : s).replace(/[&<>"']/g, function(c){ return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]; }); }
function pad(n){ return (n < 10 ? '0' : '') + n; }
function dateStr(d){ return d.getFullYear() + '-' + pad(d.getMonth()+1) + '-' + pad(d.getDate()); }
function todayStr(){ return dateStr(new Date()); }
function addDays(s, n){ var p = s.split('-'); var d = new Date(+p[0], +p[1]-1, +p[2]); d.setDate(d.getDate()+n); return dateStr(d); }
function parseDT(date, time){
  if(!date) return null;
  var p = date.split('-'); var t = (time || '23:59').split(':');
  return new Date(+p[0], +p[1]-1, +p[2], +t[0], +t[1]);
}
var DOW = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
function fmtDate(s){
  if(!s) return '';
  var p = s.split('-'); var d = new Date(+p[0], +p[1]-1, +p[2]);
  var t = todayStr();
  var lbl = s === t ? 'Today' : s === addDays(t,1) ? 'Tomorrow' : s === addDays(t,-1) ? 'Yesterday' : DOW[d.getDay()];
  return lbl + ' ' + (d.getMonth()+1) + '/' + d.getDate();
}
function fmtTime(s){
  if(!s) return '';
  var t = s.split(':'); var h = +t[0];
  return (h % 12 || 12) + ':' + t[1] + ' ' + (h < 12 ? 'AM' : 'PM');
}
function fmtStamp(s){ // "2026-10-13 14:05:22" -> "Today 2:05 PM"
  if(!s) return '';
  var p = String(s).split(' ');
  return fmtDate(p[0]) + (p[1] ? ' ' + fmtTime(p[1].slice(0,5)) : '');
}
function uuid(){
  if(window.crypto && crypto.randomUUID) return crypto.randomUUID();
  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c){ var r = Math.random()*16|0; return (c === 'x' ? r : (r&3|8)).toString(16); });
}
function num(v){ return v === '' || v == null ? null : Number(v); }
function minsUntil(d){ return Math.round((d - new Date()) / 60000); }
function fmtMins(m){ m = Math.abs(m); return m >= 60 ? Math.floor(m/60) + 'h ' + (m%60 ? (m%60) + 'm' : '') : m + 'm'; }

/* ============================== TOASTS & DIALOGS ============================== */
function toast(msg, opts){
  opts = opts || {};
  var el = document.createElement('div');
  el.className = 'toast' + (opts.bad ? ' bad' : '');
  el.innerHTML = '<span>' + esc(msg) + '</span>';
  if(opts.action){
    var b = document.createElement('button'); b.textContent = opts.action.label;
    b.onclick = function(){ el.remove(); opts.action.fn(); };
    el.appendChild(b);
  }
  $('toasts').appendChild(el);
  setTimeout(function(){ el.remove(); }, opts.ms || (opts.action ? 8000 : 4000));
}

var modalStack = null;
function openModal(html, small){
  var m = $('modal');
  m.className = 'modal' + (small ? ' sm' : '');
  m.innerHTML = html;
  $('overlay').classList.add('show');
  var x = m.querySelector('[data-close]');
  m.querySelectorAll('[data-close]').forEach(function(b){ b.onclick = closeModal; });
  var first = m.querySelector('input:not([type=checkbox]),select,textarea');
  if(first) setTimeout(function(){ first.focus(); }, 30);
  return m;
}
function closeModal(){
  $('overlay').classList.remove('show');
  $('modal').innerHTML = '';
  if(modalStack){ var fn = modalStack; modalStack = null; fn(); }
}
function modalOpen(){ return $('overlay').classList.contains('show'); }

function confirmBox(title, msg, okLabel, danger){
  return new Promise(function(resolve){
    var prev = $('modal').innerHTML ? { html:$('modal').innerHTML, cls:$('modal').className } : null;
    var m = openModal(
      '<div class="m-head"><h3>' + esc(title) + '</h3></div>' +
