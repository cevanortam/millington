/* ============================== API ============================== */
function netError(e){ var err = new Error('Can\'t reach Google Sheets. Check the network connection.'); err.network = true; err.cause = e; return err; }

function apiGet(params){
  var url = apiUrl();
  if(!url) return Promise.reject(new Error('No Web App URL set. Open Settings → Connection.'));
  var qs = Object.keys(params).map(function(k){ return encodeURIComponent(k) + '=' + encodeURIComponent(params[k]); }).join('&');
  return fetch(url + (url.indexOf('?') === -1 ? '?' : '&') + qs + '&_=' + Date.now(), { cache:'no-store' })
    .catch(function(e){ throw netError(e); })
    .then(function(r){ return r.text(); })
    .then(function(t){
      var j; try{ j = JSON.parse(t); }catch(e){ throw new Error('Unexpected reply from Google. Check the deployment is set to "Anyone".'); }
      if(!j.ok) throw new Error(j.message || 'Request failed.');
      return j;
    });
}

function apiPost(body){
  var url = apiUrl();
  if(!url) return Promise.reject(new Error('No Web App URL set. Open Settings → Connection.'));
  return fetch(url, { method:'POST', headers:{ 'Content-Type':'text/plain;charset=utf-8' }, body:JSON.stringify(body) })
    .catch(function(e){ throw netError(e); })
    .then(function(r){ return r.text(); })
    .then(function(t){
      var j; try{ j = JSON.parse(t); }catch(e){ throw new Error('Unexpected reply from Google. Check the deployment is set to "Anyone".'); }
      if(!j.ok) throw new Error(j.message || 'Request failed.');
      return j;
    });
}

/* ============================== DATA ============================== */
function saveCache(){ lsSet(LS.cache, { orders:state.orders, config:state.config, lastSync:state.lastSync }); }
function saveQueue(){ lsSet(LS.queue, state.queue); renderQueueBanner(); }

function findOrder(id){ for(var i=0;i<state.orders.length;i++) if(state.orders[i].id === id) return state.orders[i]; return null; }
function upsertLocal(o){
  var i = -1;
  for(var k=0;k<state.orders.length;k++) if(state.orders[k].id === o.id){ i = k; break; }
  if(i === -1) state.orders.push(o); else state.orders[i] = o;
}
function removeLocal(id){ state.orders = state.orders.filter(function(o){ return o.id !== id; }); }

// Applies a queued (unsent) change to the local copy so the board shows it right away.
function applyPending(item){
  if(item.kind === 'delete'){ removeLocal(item.id); return; }
  var cur = findOrder(item.order.id);
  var o = Object.assign({}, cur || { createdAt:'', rev:0 }, item.order);
  var now = todayStr() + ' ' + new Date().toTimeString().slice(0,8);
  var prev = cur ? cur.status : '';
  if(o.status !== prev){
    if(o.status === 'Staged' && !o.stagedAt) o.stagedAt = now;
    if(o.status === 'Complete'){ if(!o.stagedAt) o.stagedAt = now; o.completedAt = now; }
    if(o.status === 'Gridded'){ o.stagedAt = ''; o.completedAt = ''; }
    if(o.status === 'Staged') o.completedAt = '';
  }
  o.rev = (Number(cur ? cur.rev : 0) || 0) + 1;
  o._pending = true;
  upsertLocal(o);
}

function refresh(silent){
  if(state.syncing) return Promise.resolve();
  state.syncing = true; renderSync();
  return flushQueue()
    .then(function(){ return apiGet({ action:'getOrders', from:addDays(todayStr(), -HISTORY_DAYS) }); })
    .then(function(r){
      state.orders = r.orders || [];
      state.queue.forEach(applyPending);
      state.online = true;
      state.lastSync = new Date().toISOString();
      saveCache();
    })
    .catch(function(e){
      state.online = !e.network ? state.online : false;
      if(!silent || !e.network) toast(e.message, { bad:true });
    })
    .then(function(){ state.syncing = false; renderAll(); });
}

function loadConfig(){
  return apiGet({ action:'getConfig' }).then(function(r){
    state.config = Object.assign(state.config, r.config || {});
    saveCache(); renderAll();
  }).catch(function(){});
}

function queuePush(item){ state.queue.push(item); saveQueue(); }

function flushQueue(){
  if(!state.queue.length) return Promise.resolve();
  var items = state.queue.slice();
  var chain = Promise.resolve();
  var stopped = false;
  items.forEach(function(item){
    chain = chain.then(function(){
      if(stopped) return;
      var body = item.kind === 'delete'
        ? { action:'deleteOrder', id:item.id }
        : { action:'saveOrder', order:item.order, baseRev:item.baseRev, allowDuplicate:true };
      return apiPost(body).then(function(r){
        if(r.conflict) toast('PO ' + r.order.po + ' was changed on another PC first. Your offline change was not applied.', { bad:true, ms:9000 });
        state.queue = state.queue.filter(function(x){ return x.qid !== item.qid; }); saveQueue();
      }).catch(function(e){
        if(e.network){ stopped = true; return; }
        toast('Couldn\'t send a saved change (' + (item.order ? 'PO ' + item.order.po : 'delete') + '): ' + e.message, { bad:true, ms:9000 });
        state.queue = state.queue.filter(function(x){ return x.qid !== item.qid; }); saveQueue();
      });
    });
  });
  return chain;
}

// Saves one order. Resolves with { order } | { duplicate, matches } | { conflict, order } | { queued }.
function saveOrder(order, baseRev, allowDuplicate){
  return apiPost({ action:'saveOrder', order:order, baseRev:baseRev, allowDuplicate:!!allowDuplicate }).then(function(r){
    state.online = true;
    if(r.duplicate) return { duplicate:true, matches:r.matches };
    upsertLocal(r.order); saveCache(); renderAll();
    if(r.conflict) return { conflict:true, order:r.order };
    return { order:r.order };
  }).catch(function(e){
    if(!e.network) throw e;
    state.online = false;
    var item = { qid:uuid(), kind:'save', order:order, baseRev:baseRev, at:new Date().toISOString() };
    queuePush(item); applyPending(item); saveCache(); renderAll();
    toast('Offline — change saved on this PC and will send when the connection is back.', { ms:6000 });
    return { queued:true };
  });
}

/* ============================== DERIVED ============================== */
function pickupDT(o){ return parseDT(o.pickupDate, o.pickupTime); }
function isLate(o){
  if(o.status === 'Complete') return false;
  var d = pickupDT(o); if(!d) return false;
  return new Date() > new Date(d.getTime() + (Number(state.config.lateGraceMin) || 0) * 60000);
}
function isSoon(o){
  if(o.status === 'Complete' || isLate(o)) return false;
  var d = pickupDT(o); if(!d || !o.pickupTime) return false;
  var m = minsUntil(d); return m <= DUE_SOON_MIN;
}
function truckKey(o){ return o.carrier ? [o.carrier.trim().toLowerCase(), o.pickupDate, o.pickupTime || ''].join('|') : null; }
function truckMates(o){
  var k = truckKey(o); if(!k) return [];
  return state.orders.filter(function(x){ return x.id !== o.id && truckKey(x) === k; });
}

function inScope(o){
  var t = todayStr();
  switch(prefs.scope){
    case 'today': return o.pickupDate === t;
    case 'tomorrow': return o.pickupDate === addDays(t,1);
    case 'week': return o.pickupDate >= t && o.pickupDate <= addDays(t,6);
    case 'all': return true;
    default: return o.status !== 'Complete' || String(o.completedAt||'').slice(0,10) === t || o.pickupDate === t;
  }
}
function matchesClient(o){ return prefs.client === 'All' || (o.client || '—') === prefs.client; }
function matchesSearch(o){
  if(!state.q) return true;
  var hay = [o.po,o.orderNo,o.customer,o.client,o.carrier,o.location,o.poc,o.notes].join(' ').toLowerCase();
  return state.q.toLowerCase().split(/\s+/).every(function(w){ return hay.indexOf(w) !== -1; });
}
function matchesQuick(o){
  if(!state.quick) return true;
  if(state.quick === 'late') return isLate(o);
  if(state.quick === 'soon') return isSoon(o);
  return o.status === state.quick;
}
function sortOrders(a, b){
  var la = isLate(a), lb = isLate(b);
  if(la !== lb) return la ? -1 : 1;
  if(a.status === 'Complete' && b.status === 'Complete') return String(b.completedAt).localeCompare(String(a.completedAt));
  var da = pickupDT(a), db = pickupDT(b);
  return (da ? da.getTime() : 9e15) - (db ? db.getTime() : 9e15) || String(a.po).localeCompare(String(b.po));
}

/* ============================== RENDER ============================== */
function renderAll(){
  renderSync(); renderQueueBanner(); renderStats(); renderChips(); renderBoard();
}

function renderClock(){
  var d = new Date();
  $('clock').textContent = DOW[d.getDay()] + ' ' + (d.getMonth()+1) + '/' + d.getDate() + '  ' + fmtTime(pad(d.getHours()) + ':' + pad(d.getMinutes()));
}

function renderSync(){
  var p = $('syncPill'), t = $('syncText');
  p.className = 'pill';
  if(state.syncing){ t.textContent = 'Syncing…'; return; }
  var when = state.lastSync ? new Date(state.lastSync) : null;
  var ts = when ? fmtTime(pad(when.getHours()) + ':' + pad(when.getMinutes())) : '';
  if(!apiUrl()){ p.classList.add('bad'); t.textContent = 'Not connected'; return; }
  if(state.online === false){ p.classList.add('bad'); t.textContent = 'Offline' + (ts ? ' · last ' + ts : ''); return; }
  if(state.queue.length){ p.classList.add('warn'); t.textContent = state.queue.length + ' unsent'; return; }
  if(state.online){ p.classList.add('ok'); t.textContent = 'Live · ' + ts; return; }
  t.textContent = 'Connecting…';
}

function renderQueueBanner(){
  var b = $('queueBanner');
  if(!state.queue.length){ b.classList.remove('show'); return; }
  b.classList.add('show');
  b.innerHTML = '⚠ <b>' + state.queue.length + ' change' + (state.queue.length === 1 ? '' : 's') + '</b> saved on this PC but not yet sent to Google Sheets. ' +
    'They will send automatically when the connection is back.' +
    ' <button class="btn" id="retryQ" style="margin-left:auto">Retry now</button>';
  $('retryQ').onclick = function(){ refresh(); };
}

function baseSet(){ return state.orders.filter(function(o){ return inScope(o) && matchesClient(o); }); }

function renderStats(){
  var s = baseSet();
  var c = { Gridded:0, Staged:0, Complete:0, late:0, soon:0 };
  s.forEach(function(o){ c[o.status] = (c[o.status]||0) + 1; if(isLate(o)) c.late++; if(isSoon(o)) c.soon++; });
  var defs = [
    ['Gridded','Gridded','var(--gridded)','In progress'],
    ['Staged','Staged','var(--staged)','On the dock'],
    ['Complete','Complete','var(--complete)','Picked up'],
    ['late','Late','var(--red)','Past pickup time'],
    ['soon','Due soon','var(--amber)','Within ' + (DUE_SOON_MIN/60) + ' hours']
  ];
  $('stats').innerHTML = defs.map(function(d){
    return '<button class="stat' + (state.quick === d[0] ? ' on' : '') + '" data-q="' + d[0] + '" style="--c:' + d[2] + '">' +
      '<div class="lbl">' + d[1] + '</div><div class="num">' + (c[d[0]]||0) + '</div><div class="sub">' + d[3] + '</div></button>';
  }).join('');
  $('stats').querySelectorAll('.stat').forEach(function(b){
    b.onclick = function(){ state.quick = state.quick === b.dataset.q ? null : b.dataset.q; renderStats(); renderBoard(); };
  });
}

function renderChips(){
  var set = {};
  state.config.clients.forEach(function(c){ set[c] = 1; });
  state.orders.forEach(function(o){ if(o.client) set[o.client] = 1; });
  var list = Object.keys(set).sort();
  if(prefs.client !== 'All' && list.indexOf(prefs.client) === -1) list.push(prefs.client);
  var el = $('clientChips');
  if(list.length < 2 && prefs.client === 'All'){ el.innerHTML = ''; return; }
  el.innerHTML = ['All'].concat(list).map(function(c){
    return '<button class="chip' + (prefs.client === c ? ' on' : '') + '" data-c="' + esc(c) + '">' + esc(c === 'All' ? 'All clients' : c) + '</button>';
  }).join('');
  el.querySelectorAll('.chip').forEach(function(b){
    b.onclick = function(){ prefs.client = b.dataset.c; savePrefs(); renderChips(); renderStats(); renderBoard(); };
  });
}

function tileHTML(o){
  var late = isLate(o), soon = isSoon(o);
  var d = pickupDT(o);
  var flags = [];
  if(late) flags.push('<span class="flag late">Late ' + (d ? fmtMins(minsUntil(d)) : '') + '</span>');
  else if(soon) flags.push('<span class="flag soon">Due in ' + fmtMins(minsUntil(d)) + '</span>');
  if(o.eta && o.pickupTime && o.eta > o.pickupTime && o.status !== 'Complete') flags.push('<span class="flag eta">ETA after appt</span>');
  var mates = truckMates(o);
  if(mates.length) flags.push('<span class="flag truck" title="Same carrier and pickup: ' + esc(mates.map(function(m){ return m.po; }).join(', ')) + '">🚚 +' + mates.length + ' PO' + (mates.length > 1 ? 's' : '') + ' same truck</span>');
  if(o._pending) flags.push('<span class="flag unsent">Unsent</span>');

  var sub = [o.orderNo ? 'Order <b>' + esc(o.orderNo) + '</b>' : '', o.customer ? '<b>' + esc(o.customer) + '</b>' : '', o.client ? esc(o.client) : '']
    .filter(Boolean).join(' · ');

  var pickup = o.pickupDate ? esc(fmtDate(o.pickupDate)) + (o.pickupTime ? ' · ' + esc(fmtTime(o.pickupTime)) : '') : '—';
  if(o.eta) pickup += ' <span style="color:var(--muted)">(ETA ' + esc(fmtTime(o.eta)) + ')</span>';
  var carrier = o.carrier ? esc(o.carrier) : '<span style="color:var(--faint)">Not set</span>';
  if(o.poc) carrier += ' <span style="color:var(--muted)">· ' + esc(o.poc) + '</span>';
  if(o.pocPhone) carrier += ' <a href="tel:' + esc(o.pocPhone.replace(/[^\d+]/g,'')) + '" onclick="event.stopPropagation()">' + esc(o.pocPhone) + '</a>';

  var done = '';
  if(o.status === 'Complete' && o.completedAt) done = '<div class="t-sub">Completed ' + esc(fmtStamp(o.completedAt)) + '</div>';
  else if(o.status === 'Staged' && o.stagedAt) done = '<div class="t-sub">Staged ' + esc(fmtStamp(o.stagedAt)) + '</div>';

  var next = o.status === 'Gridded' ? 'Staged' : o.status === 'Staged' ? 'Complete' : null;
  var actions = next ? '<div class="t-actions hide-tv"><button class="btn adv" data-adv="' + esc(o.id) + '" style="--next:var(--' + next.toLowerCase() + ')">Mark ' + next + ' →</button></div>' : '';

  return '<div class="tile s-' + esc(o.status) + (late ? ' late' : '') + (o._pending ? ' pending' : '') + '" data-id="' + esc(o.id) + '">' +
    '<div class="t-head"><div class="t-po">PO ' + esc(o.po) + '</div><span class="t-status">' + esc(o.status) + '</span></div>' +
    '<div class="t-body">' +
      (sub ? '<div class="t-sub">' + sub + '</div>' : '') +
      '<div class="t-row"><span class="k">Pickup</span><span class="v">' + pickup + '</span></div>' +
      '<div class="t-row"><span class="k">Carrier</span><span class="v">' + carrier + '</span></div>' +
      '<div class="t-loc"><span class="k">Staged at</span><span class="v' + (o.location ? '' : ' none') + '">' + (o.location ? esc(o.location) : 'Not assigned') + '</span></div>' +
      done +
      (flags.length ? '<div class="flags">' + flags.join('') + '</div>' : '') +
    '</div>' + actions + '</div>';
}

function renderBoard(){
  var list = baseSet().filter(matchesSearch).filter(matchesQuick).sort(sortOrders);
  var b = $('board');
  if(prefs.view === 'grid'){
    b.innerHTML = list.length ? '<div class="grid">' + list.map(tileHTML).join('') + '</div>' : '<div class="lane"><div class="empty">' + emptyMsg() + '</div></div>';
  } else {
    b.innerHTML = '<div class="lanes">' + STATUSES.map(function(s){
      var items = list.filter(function(o){ return o.status === s; });
      return '<section class="lane"><div class="lane-head" style="--c:var(--' + s.toLowerCase() + ')"><span class="sw"></span><h2>' + s + '</h2><span class="count">' + items.length + '</span></div>' +
        '<div class="lane-body">' + (items.length ? items.map(tileHTML).join('') : '<div class="empty">Nothing ' + s.toLowerCase() + '</div>') + '</div></section>';
    }).join('') + '</div>';
  }
  b.querySelectorAll('.tile').forEach(function(t){ t.onclick = function(){ openOrder(findOrder(t.dataset.id)); }; });
  b.querySelectorAll('[data-adv]').forEach(function(btn){
    btn.onclick = function(e){ e.stopPropagation(); advance(findOrder(btn.dataset.adv)); };
  });
}
function emptyMsg(){
  if(!state.orders.length) return state.online === false ? 'Can\'t reach Google Sheets and nothing is saved on this PC yet.' : 'No orders yet. Click <b>＋ Add Order</b> to put the first one on the board.';
  return 'No orders match the current filters.';
}

/* ============================== ORDER EDITOR ============================== */
function uniq(arr){ var s = {}; return arr.filter(function(x){ x = String(x||'').trim(); if(!x || s[x.toLowerCase()]) return false; s[x.toLowerCase()] = 1; return true; }).sort(); }
function datalist(id, values){ return '<datalist id="' + id + '">' + uniq(values).map(function(v){ return '<option value="' + esc(v) + '">'; }).join('') + '</datalist>'; }
function pluck(k){ return state.orders.map(function(o){ return o[k]; }); }

function openOrder(o, preset){
  var isNew = !o;
  if(isNew){
    o = Object.assign({ id:'', po:'', orderNo:'', client:prefs.lastClient || '', customer:'', carrier:'', poc:'', pocPhone:'',
