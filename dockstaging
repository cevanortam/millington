  $('oStatus').querySelectorAll('button').forEach(function(b){
    b.onclick = function(){ status = b.dataset.s; $('oStatus').querySelectorAll('button').forEach(function(x){ x.classList.toggle('on', x === b); }); };
  });
  if(!isNew){
    apiGet({ action:'getHistory', id:o.id }).then(function(r){
