        f('carrier','Carrier','text',{list:'dl_carrier'}) +
        f('poc','Carrier POC','text',{ph:'Contact name'}) +
        f('pocPhone','POC Phone','tel') +
        f('location','Staged Location','text',{list:'dl_door',ph:'e.g. Door 12'}) +
        f('pickupDate','Pickup Date','date',{req:1}) +
        f('pickupTime','Pickup Time','time',{hint:'Scheduled appointment'}) +
        f('eta','Carrier ETA','time',{hint:'Latest estimate from the carrier'}) +
