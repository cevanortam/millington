    return '';
  }

  function doSave(another){
    var d = collect(); var v = validate(d);
    if(v){ $('oErr').textContent = v; return; }
    var go = function(allowDup){
      $('oErr').textContent = '';
      document.querySelectorAll('#oSave,#oSaveMore').forEach(function(b){ b.disabled = true; });
      return saveOrder(d, isNew ? null : o.rev, allowDup).then(function(r){
        if(r.duplicate){
          var m = r.matches[0];
          return confirmBox('PO already on the board',
            'PO <b>' + esc(d.po) + '</b>' + (d.client ? ' for ' + esc(d.client) : '') + ' is already on the board (' + esc(m.status) + ', pickup ' + esc(fmtDate(m.pickupDate)) + ').<br><br>Add it again anyway? Only do this for a separate shipment of the same PO.',
            'Add anyway').then(function(yes){
              if(yes) return go(true);
              openOrder(null, d);
            });
        }
        if(d.client) { prefs.lastClient = d.client; savePrefs(); }
        if(r.conflict){
          closeModal();
          toast('Someone else updated PO ' + r.order.po + ' first. Their version is shown — make your change again if it\'s still needed.', { bad:true, ms:9000 });
          openOrder(r.order); return;
        }
        if(!r.queued) toast((isNew ? 'Added' : 'Saved') + ' PO ' + d.po);
        if(another){
          openOrder(null, { client:d.client, customer:d.customer, carrier:d.carrier, poc:d.poc, pocPhone:d.pocPhone,
            pickupDate:d.pickupDate, pickupTime:d.pickupTime, eta:d.eta, location:d.location });
        } else closeModal();
      }).catch(function(e){
        if($('oErr')){
          $('oErr').textContent = e.message;
          document.querySelectorAll('#oSave,#oSaveMore').forEach(function(b){ b.disabled = false; });
        } else {
          // The form was replaced by a confirm dialog; reopen it with the user's edits and show the error.
          if(isNew) openOrder(null, Object.assign({}, d, { status:o.status })); else openOrder(Object.assign({}, o, d, { status:o.status }));
          if($('oErr')) $('oErr').textContent = e.message;
        }
      });
    };
    go(false);
  }
  $('oSave').onclick = function(){ doSave(false); };
  if($('oSaveMore')) $('oSaveMore').onclick = function(){ doSave(true); };
  if($('oDel')) $('oDel').onclick = function(){
    confirmBox('Delete order', 'Delete PO <b>' + esc(o.po) + '</b> from the board? It stays in the sheet\'s History tab.', 'Delete', true).then(function(yes){
      if(!yes) return openOrder(o);
      apiPost({ action:'deleteOrder', id:o.id }).then(function(){
        removeLocal(o.id); saveCache(); renderAll(); toast('Deleted PO ' + o.po);
      }).catch(function(e){
        if(e.network){ queuePush({ qid:uuid(), kind:'delete', id:o.id }); removeLocal(o.id); saveCache(); renderAll(); toast('Offline — delete will send when the connection is back.'); }
        else toast(e.message, { bad:true });
      });
    });
  };
}

function truckBlock(o){
  var mates = truckMates(o);
  if(!mates.length) return '';
  return '<div class="hist"><h4>🚚 Same truck (' + esc(o.carrier) + ', ' + esc(fmtDate(o.pickupDate)) + (o.pickupTime ? ' ' + esc(fmtTime(o.pickupTime)) : '') + ')</h4><ul>' +
    mates.map(function(m){
      return '<li><a href="#" data-open-mate="' + esc(m.id) + '">PO ' + esc(m.po) + '</a> · ' + esc(m.status) + (m.location ? ' · ' + esc(m.location) : '') + (m.customer ? ' · ' + esc(m.customer) : '') + '</li>';
    }).join('') + '</ul></div>';
}

function advance(o){
  if(!o) return;
  var next = o.status === 'Gridded' ? 'Staged' : 'Complete';
  var prevStatus = o.status;
  saveOrder({ id:o.id, po:o.po, pickupDate:o.pickupDate, status:next }, o.rev, true).then(function(r){
    if(r.conflict){ toast('PO ' + o.po + ' was just changed on another PC. The board now shows the latest — try again if needed.', { bad:true, ms:8000 }); return; }
    toast('PO ' + o.po + ' → ' + next, { action:{ label:'Undo', fn:function(){
      var c = findOrder(o.id); if(!c) return;
      saveOrder({ id:c.id, po:c.po, pickupDate:c.pickupDate, status:prevStatus }, c.rev, true)
        .then(function(){ toast('Undone — PO ' + o.po + ' back to ' + prevStatus); });
    } } });
  }).catch(function(e){ toast(e.message, { bad:true }); });
}

/* ============================== EXPORT ============================== */
var EXPORT_COLS = [
  ['po','PO Number'],['orderNo','Order #'],['client','Client'],['customer','Customer'],['carrier','Carrier'],
  ['poc','Carrier POC'],['pocPhone','POC Phone'],['pickupDate','Pickup Date'],['pickupTime','Pickup Time'],['eta','Carrier ETA'],
  ['location','Staged Location'],['status','Status'],
  ['stagedAt','Staged At'],['completedAt','Completed (Picked Up) At'],['notes','Notes']
];

function openExport(){
  var t = todayStr();
  var clients = uniq(state.config.clients.concat(pluck('client')));
  openModal(
    '<div class="m-head"><h3>Export for customer</h3><button class="btn icon ghost x" data-close>✕</button></div>' +
    '<div class="m-body"><div class="form">' +
      '<div class="f"><label>Pickup date from</label><input type="date" id="exFrom" value="' + addDays(t,-6) + '"></div>' +
      '<div class="f"><label>Pickup date to</label><input type="date" id="exTo" value="' + t + '"></div>' +
      '<div class="f"><label>Client</label><select id="exClient"><option value="All">All clients</option>' +
        clients.map(function(c){ return '<option' + (prefs.client === c ? ' selected' : '') + '>' + esc(c) + '</option>'; }).join('') + '</select></div>' +
      '<div class="f"><label>Format</label><select id="exFmt"><option value="xlsx">Excel (.xlsx)</option><option value="csv">CSV</option></select></div>' +
      '<div class="f full"><label>Statuses</label><div class="checks">' +
        STATUSES.map(function(s){ return '<label><input type="checkbox" class="exSt" value="' + s + '" checked> ' + s + '</label>'; }).join('') +
      '</div></div>' +
    '</div><div class="err" id="exErr"></div><div class="meta">Pulls straight from Google Sheets, so it includes every PC\'s entries — not just what\'s on this screen. Internal columns (who edited, row IDs) are left out.</div></div>' +
    '<div class="m-foot"><div class="spacer"></div><button class="btn" data-close>Cancel</button><button class="btn primary" id="exGo">Download</button></div>');
  $('exGo').onclick = function(){
    var from = $('exFrom').value, to = $('exTo').value, client = $('exClient').value, fmt = $('exFmt').value;
    var sts = Array.prototype.slice.call(document.querySelectorAll('.exSt:checked')).map(function(c){ return c.value; });
    if(!from || !to || from > to){ $('exErr').textContent = 'Pick a valid date range.'; return; }
    if(!sts.length){ $('exErr').textContent = 'Pick at least one status.'; return; }
    $('exGo').disabled = true; $('exErr').textContent = '';
    apiGet({ action:'getOrders', from:from, to:to }).then(function(r){ return r.orders; })
      .catch(function(e){
        if(!e.network) throw e;
        toast('Offline — exporting the copy saved on this PC.', { ms:6000 });
        return state.orders;
      })
      .then(function(rows){
        rows = rows.filter(function(o){
          return o.pickupDate >= from && o.pickupDate <= to && sts.indexOf(o.status) !== -1 && (client === 'All' || o.client === client);
        }).sort(function(a,b){ return (a.pickupDate + (a.pickupTime||'')).localeCompare(b.pickupDate + (b.pickupTime||'')) || a.po.localeCompare(b.po); });
        if(!rows.length){ $('exErr').textContent = 'No orders match those filters.'; $('exGo').disabled = false; return; }
        var name = 'dockstaging_' + (client === 'All' ? 'All' : client.replace(/[^\w-]+/g,'_')) + '_' + from + '_to_' + to;
        return (fmt === 'xlsx' ? exportXlsx(rows, name) : Promise.resolve(exportCsv(rows, name))).then(function(){
          closeModal(); toast('Exported ' + rows.length + ' order' + (rows.length === 1 ? '' : 's'));
        });
      })
      .catch(function(e){ $('exErr').textContent = e.message; $('exGo').disabled = false; });
  };
}

function exportValue(o, k){
  var v = o[k] == null ? '' : o[k];
  if((k === 'pickupTime' || k === 'eta') && v) return fmtTime(v);
  return v;
}
function download(blob, filename){
  var a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = filename;
  document.body.appendChild(a); a.click(); setTimeout(function(){ URL.revokeObjectURL(a.href); a.remove(); }, 500);
}
function exportCsv(rows, name){
  var q = function(v){ v = String(v == null ? '' : v); if(/^[=+\-@]/.test(v)) v = "'" + v; return /[",\n]/.test(v) ? '"' + v.replace(/"/g,'""') + '"' : v; };
  var lines = [EXPORT_COLS.map(function(c){ return q(c[1]); }).join(',')]
    .concat(rows.map(function(o){ return EXPORT_COLS.map(function(c){ return q(exportValue(o, c[0])); }).join(','); }));
  download(new Blob(['﻿' + lines.join('\r\n')], { type:'text/csv;charset=utf-8' }), name + '.csv');
}
var xlsxLoading = null;
function loadXlsx(){
  if(window.XLSX) return Promise.resolve();
  if(xlsxLoading) return xlsxLoading;
  xlsxLoading = new Promise(function(res, rej){
    var s = document.createElement('script');
    s.src = 'https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js';
    s.onload = function(){ res(); }; s.onerror = function(){ xlsxLoading = null; rej(new Error('xlsx')); };
    document.head.appendChild(s);
  });
  return xlsxLoading;
}
function exportXlsx(rows, name){
  return loadXlsx().then(function(){
    var aoa = [EXPORT_COLS.map(function(c){ return c[1]; })].concat(rows.map(function(o){ return EXPORT_COLS.map(function(c){ return exportValue(o, c[0]); }); }));
    var ws = XLSX.utils.aoa_to_sheet(aoa);
    ws['!cols'] = EXPORT_COLS.map(function(c, i){
      var w = c[1].length; rows.forEach(function(o){ w = Math.max(w, String(exportValue(o, c[0])).length); });
      return { wch: Math.min(40, w + 2) };
    });
    ws['!autofilter'] = { ref: XLSX.utils.encode_range({ s:{r:0,c:0}, e:{r:rows.length, c:EXPORT_COLS.length-1} }) };
    var wb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(wb, ws, 'Millington Dock Staging');
    XLSX.writeFile(wb, name + '.xlsx');
  }).catch(function(){
    toast('Excel export unavailable on this network — downloaded CSV instead (opens in Excel).', { ms:7000 });
    exportCsv(rows, name);
  });
}

/* ============================== SETTINGS ============================== */
function openSettings(tab){
  tab = tab || 'board';
  var tabs = [['board','Board'],['connection','Connection']];
  var body = '';
  var c = state.config;
  if(tab === 'connection'){
    body =
      '<div class="form" style="grid-template-columns:1fr">' +
        '<div class="f"><label>Google Sheets Web App URL</label><input id="stUrl" value="' + esc(apiUrl()) + '" spellcheck="false">' +
        '<div class="hint">Built in by default. Only change this if the script is redeployed under a new URL. Saved on this PC only.</div></div>' +
        '<div class="f"><label>Auto-refresh (seconds)</label><input id="stRefresh" type="number" min="10" step="5" value="' + esc(prefs.refreshSec) + '"></div>' +
      '</div><div class="err" id="stErr"></div>' +
      '<div class="meta">Millington Dock Staging v' + APP_VERSION + (state.lastSync ? ' · Last sync ' + esc(new Date(state.lastSync).toLocaleString()) : '') + '</div>';
  } else {
    var ta = function(id, label, arr, hint){ return '<div class="f full"><label>' + label + '</label><textarea id="' + id + '" placeholder="One per line">' + esc((arr||[]).join('\n')) + '</textarea><div class="hint">' + hint + '</div></div>'; };
    body =
      '<div class="form">' +
        '<div class="f"><label>Late after (minutes past pickup)</label><input id="stGrace" type="number" min="0" value="' + esc(c.lateGraceMin) + '"></div>' +
        ta('stDoors','Doors / staging locations', c.doors, 'Suggested in the Staged Location field.') +
        ta('stClients','Clients', c.clients, 'Shown as filter chips and suggested when adding orders.') +
        ta('stCustomers','Customers', c.customers, 'e.g. Indigo, Von Maur.') +
        ta('stCarriers','Carriers', c.carriers, 'Suggested in the Carrier field.') +
      '</div><div class="err" id="stErr"></div><div class="meta">Saved to the sheet\'s Config tab, so every PC gets the same lists.</div>';
  }
  openModal(
    '<div class="m-head"><h3>Settings</h3><button class="btn icon ghost x" data-close>✕</button></div>' +
    '<div class="m-body"><div class="tabs">' + tabs.map(function(t){ return '<button data-tab="' + t[0] + '"' + (t[0] === tab ? ' class="on"' : '') + '>' + t[1] + '</button>'; }).join('') + '</div>' +
    body + '</div>' +
    '<div class="m-foot">' + (tab === 'connection' ? '<button class="btn" id="stTest">Test connection</button>' : '') +
    '<div class="spacer"></div><button class="btn" data-close>Close</button><button class="btn primary" id="stSave">Save</button></div>');
  document.querySelectorAll('[data-tab]').forEach(function(b){ b.onclick = function(){ openSettings(b.dataset.tab); }; });
  var err = function(m){ $('stErr').textContent = m || ''; };

  if(tab === 'connection'){
    $('stTest').onclick = function(){
      var prev = lsGet(LS.url, ''); lsSet(LS.url, $('stUrl').value.trim());
      err(''); $('stTest').disabled = true;
      apiGet({ action:'ping' }).then(function(r){ toast('Connected — backend v' + r.version); })
        .catch(function(e){ err(e.message); }).then(function(){ lsSet(LS.url, prev); $('stTest').disabled = false; });
    };
    $('stSave').onclick = function(){
      var u = $('stUrl').value.trim();
      if(u && !/^https:\/\/script\.google\.com\/macros\/s\/.+\/exec$/.test(u)) return err('That doesn\'t look like an Apps Script Web App URL (it should end in /exec).');
      if(!u || u === DEFAULT_URL) lsDel(LS.url); else lsSet(LS.url, u);
      prefs.refreshSec = Math.max(10, Number($('stRefresh').value) || 30); savePrefs(); startTimers();
      closeModal(); toast('Settings saved'); refresh(); loadConfig();
    };
  } else {
    var lines = function(id){ return $(id).value.split(/\n|,/).map(function(s){ return s.trim(); }).filter(Boolean); };
    $('stSave').onclick = function(){
      err(''); $('stSave').disabled = true;
      apiPost({ action:'saveConfig', config:{ lateGraceMin:$('stGrace').value,
        doors:lines('stDoors'), clients:lines('stClients'), customers:lines('stCustomers'), carriers:lines('stCarriers') } })
        .then(function(r){ state.config = Object.assign(state.config, r.config); saveCache(); renderAll(); closeModal(); toast('Board settings saved'); })
        .catch(function(e){ err(e.message); $('stSave').disabled = false; });
    };
  }
}

/* ============================== TV MODE ============================== */
function enterTv(){
  document.body.classList.add('tv');
  prefs.tv = true; savePrefs();
  if(document.documentElement.requestFullscreen) document.documentElement.requestFullscreen().catch(function(){});
}
function exitTv(){
  document.body.classList.remove('tv');
  prefs.tv = false; savePrefs();
  if(document.fullscreenElement && document.exitFullscreen) document.exitFullscreen().catch(function(){});
}

/* ============================== WIRING ============================== */
var timers = [];
function startTimers(){
  timers.forEach(clearInterval); timers = [];
  timers.push(setInterval(function(){ if(!document.hidden) refresh(true); }, Math.max(10, prefs.refreshSec) * 1000));
  timers.push(setInterval(function(){ renderClock(); if(!modalOpen()){ renderStats(); renderBoard(); } renderSync(); }, 30000));
  timers.push(setInterval(loadConfig, 5 * 60000));
}

function init(){
  $('addBtn').onclick = function(){ openOrder(null); };
  $('exportBtn').onclick = openExport;
  $('refreshBtn').onclick = function(){ refresh(); loadConfig(); };
  $('settingsBtn').onclick = function(){ openSettings(); };
  $('tvBtn').onclick = enterTv;
  $('tvExitBtn').onclick = exitTv;
  $('overlay').addEventListener('mousedown', function(e){ if(e.target === $('overlay')) closeModal(); });
  document.addEventListener('keydown', function(e){
    if(e.key === 'Escape'){ if(modalOpen()) closeModal(); else if(document.body.classList.contains('tv')) exitTv(); }
    if(e.key === '/' && !modalOpen() && document.activeElement.tagName !== 'INPUT'){ e.preventDefault(); $('search').focus(); }
  });
  var st;
  $('search').addEventListener('input', function(){ clearTimeout(st); st = setTimeout(function(){ state.q = $('search').value.trim(); renderBoard(); }, 120); });
  var bindSeg = function(id, key){
    var seg = $(id);
    seg.querySelectorAll('button').forEach(function(b){
      b.classList.toggle('on', b.dataset.v === prefs[key]);
      b.onclick = function(){ prefs[key] = b.dataset.v; savePrefs(); seg.querySelectorAll('button').forEach(function(x){ x.classList.toggle('on', x === b); }); renderStats(); renderBoard(); };
    });
  };
  bindSeg('scopeSeg','scope'); bindSeg('viewSeg','view');
  window.addEventListener('online', function(){ refresh(true); });
  document.addEventListener('visibilitychange', function(){ if(!document.hidden) refresh(true); });
  if(prefs.tv) document.body.classList.add('tv');

  renderClock(); renderAll();
  refresh(true); loadConfig(); startTimers();
}

document.addEventListener('DOMContentLoaded', init);
})();
</script>
